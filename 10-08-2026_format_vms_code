occ = gpd.read_file('data/raw/geonb/nb_mineral_occurrences.gpkg')
occ_wgs84 = occ.to_crs(epsg=4326)

lines = []
lines.append("VMS_DEPOSITS = [")
lines.append("    # Name,                            Lon,       Lat,    Notes")
for vs_name, search_alias, notes in van_staal_45:
    m = occ[occ['name'].str.contains(search_alias, case=False, na=False)]
    best = m.iloc[0]
    idx_best = m.index[0]
    pt = occ_wgs84.loc[idx_best].geometry
    name_escaped = vs_name.replace('"', '\\"')
    lines.append(f'    ("{name_escaped}", {pt.x:11.4f}, {pt.y:8.4f}, "{notes}"),')
lines.append("]")

code_str = "\n".join(lines)
